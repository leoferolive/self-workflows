# Template OPCIONAL de CronJob.
# `kubectl apply -f k8s/` ignora a extensão .example — para ativar,
# renomeie para cronjob.yaml, ajuste schedule/command e commite.
#
# Convenções do cluster (memória é o recurso escasso):
# - requests pequenos e limits contidos
# - concurrencyPolicy: Forbid
# - horário de madrugada, fora de "0 */4" (judge do chat-api)
# - failedJobsHistoryLimit >= 3 para o alerta KubeJobFailed enxergar a falha
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{APP_NAME}}-job
  namespace: {{APP_NAME}}
spec:
  schedule: "50 3 * * *"
  timeZone: America/Sao_Paulo
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 2
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 900
      template:
        spec:
          restartPolicy: Never
          containers:
            - name: {{APP_NAME}}-job
              image: ghcr.io/{{GITHUB_USER}}/{{APP_NAME}}:latest
              command: ["/bin/sh", "-c", "echo 'implemente o job aqui'"]
              resources:
                requests:
                  cpu: 50m
                  memory: 32Mi
                limits:
                  cpu: 200m
                  memory: 128Mi
